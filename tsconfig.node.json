{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "declaration": true,
    "outDir": "dist-types",
    "jsx": "react-jsx"
  },
  "include": ["electron/**/*", "shared/**/*", "vite.config.ts", "scripts/**/*"]
}
