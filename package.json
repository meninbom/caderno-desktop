{
  "name": "caderno",
  "version": "0.13.1",
  "description": "App desktop de anotações inspirado no Evernote",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "cross-env CADERNO_DEV=1 concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "build": "node scripts/build-icon.cjs && tsc -b && vite build && node scripts/build-electron.mjs",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "lint": "tsc -b",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder",
    "test:functional": "node scripts/test-functional.mjs",
    "test:folders": "node scripts/test-folders-ui.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:palette": "node scripts/test-command-palette.mjs",
    "test:clipper": "node scripts/test-clipper-integration.mjs",
    "test:raycast": "node scripts/test-raycast-integration.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run test:functional && npm run test:clipper && npm run test:transcription",
    "test:transcription": "node scripts/test-transcription-integration.mjs"
  },
  "dependencies": {
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "better-sqlite3": "^11.7.0",
    "fix-webm-duration": "^1.0.6",
    "lucide-react": "^0.469.0",
    "mailparser": "^3.12.4",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.caderno.app",
    "productName": "Caderno",
    "directories": {
      "output": "release-0.13.1"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/ocr-winrt.ps1"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "9.1.0"
    }
  }
}
