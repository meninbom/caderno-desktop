{
  "manifest_version": 3,
  "name": "Caderno Web Clipper",
  "version": "0.10.3",
  "description": "Salva páginas no Caderno local após uma ação explícita.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43187/*"
  ],
  "action": {
    "default_title": "Salvar no Caderno",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Abrir o Web Clipper"
    }
  }
}
