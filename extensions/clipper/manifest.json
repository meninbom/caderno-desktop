{
  "manifest_version": 3,
  "name": "Caderno Web Clipper",
  "version": "0.15.0",
  "description": "Salva páginas no Caderno local após uma ação explícita.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:43187/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Salvar no Caderno",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Abrir o Web Clipper"
    }
  }
}
